# AeroVoyage AI Environment Configuration
# Agent seeds ensure consistent cryptographic addresses on Agentverse and ASI:One

# Concierge Agent (ASI:One Discoverable Frontline Agent)
CONCIERGE_AGENT_NAME=aerovoyage_concierge
CONCIERGE_AGENT_SEED=aerovoyage_concierge_seed_phrase_hackathon_2026_01
CONCIERGE_AGENT_PORT=8000
# Optional: Set to 'true' or provide your Agentverse Mailbox API Key to connect via Mailbox
CONCIERGE_MAILBOX=false

# Logistics & Live Intelligence Agent (Worker Agent)
LOGISTICS_AGENT_NAME=aerovoyage_logistics
LOGISTICS_AGENT_SEED=aerovoyage_logistics_seed_phrase_hackathon_2026_02
LOGISTICS_AGENT_PORT=8001
LOGISTICS_MAILBOX=false

# Settlement & Escrow Agent (Payment Protocol Agent)
SETTLEMENT_AGENT_NAME=aerovoyage_settlement
SETTLEMENT_AGENT_SEED=aerovoyage_settlement_seed_phrase_hackathon_2026_03
SETTLEMENT_AGENT_PORT=8002
SETTLEMENT_MAILBOX=false

# Agentverse Registration Keys
AGENTVERSE_KEY=your_agentverse_api_key_here
AGENT_SEED_PHRASE=aerovoyage_standalone_concierge_hackathon_seed_2026

# Platform Coordination Fee (in FET)
AGENT_FEE_FET=5.0

# FET price fallback (used when CoinGecko API is unavailable)
FET_FALLBACK_RATE=1.35
FET_ESTIMATED_USD_RATE=1.35

# Default session values — leave empty for fully dynamic (user-driven) behavior
DEFAULT_ORIGIN=
DEFAULT_DESTINATION=
DEFAULT_BUDGET_USD=1500.0

# Groq Free Tier LLM Configuration
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
